# Rendered by the official nginx image's envsubst step into
# /etc/nginx/conf.d/default.conf. Only variables that exist in the
# container's environment are substituted, so NGINX's own $variables
# survive untouched.

# Docker's embedded DNS. Together with `set $upstream ...; proxy_pass
# $upstream;` this resolves upstream hostnames per request instead of at
# config load, so the gateway starts even when upstream containers don't
# exist yet — those routes answer 503 until they do.
resolver 127.0.0.11 valid=10s ipv6=off;
# Unknown names can be forwarded to the host resolver and time out; the
# 30s default would hang every request to a not-yet-existing upstream.
resolver_timeout 2s;

map $http_x_correlation_id $correlation_id {
    default $http_x_correlation_id;
    ""      $request_id;
}

# Empty value => add_header emits nothing, so a disallowed origin simply
# gets no Access-Control-Allow-Origin header.
map $http_origin $cors_allow_origin {
    default "";
    "${CORS_ALLOWED_ORIGINS}" "${CORS_ALLOWED_ORIGINS}";
}

limit_req_zone $binary_remote_addr zone=gateway:10m rate=${RATE_LIMIT_PER_SECOND}r/s;

# Login brute-force budget: security-threat-model S-1 asks for at most
# 10 attempts per IP in 5 minutes. limit_req has no literal "N per window":
# it is a token bucket (rate refills tokens, burst is the bucket size, so
# up to burst+1 requests pass at once and then `rate` per time unit).
# Over any 5 minutes that admits at most (burst + 1) + 5 * rate-per-minute.
# Candidates considered:
#   rate=2r/m burst=9  -> 10 at once, 10/5min sustained, but up to 20 in a
#                         single 5-minute window (bucket + refill). Exceeds
#                         the stated maximum.
#   rate=2r/m burst=4  -> 5 at once, 10/5min sustained, up to 15 in a window.
#   rate=1r/m burst=4  -> 5 at once, 5/5min sustained, never more than 10 in
#                         any 5-minute window.        <- chosen
# Chosen because S-1 is a ceiling ("maximum 10"): this is the only option
# that never exceeds it. Cost: after the 5 quick attempts a legitimate user
# waits ~1 minute per further attempt (half the 10/5min sustained rate).
# The key is the client IP; behind a shared NAT/proxy many users share it.
limit_req_zone $binary_remote_addr zone=login:10m rate=1r/m;
limit_req_status 429;

server {
    listen 8000;
    server_tokens off;

    # add_header is only inherited by blocks that declare none of their
    # own, so every block that adds a header includes this snippet too.
    include /etc/nginx/snippets/response-headers.conf;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"synkro-api-gateway"}';
    }

    location / {
        default_type application/json;
        return 404 '{"error":"NOT_FOUND","message":"no route matches this path","traceId":"$correlation_id"}';
    }

    location @unauthorized {
        default_type application/json;
        return 401 '{"error":"UNAUTHORIZED","message":"a valid Authorization header is required","traceId":"$correlation_id"}';
    }

    location @ratelimited {
        default_type application/json;
        include /etc/nginx/snippets/response-headers.conf;
        add_header Retry-After 1 always;
        return 429 '{"error":"TOO_MANY_REQUESTS","message":"rate limit exceeded, retry shortly","traceId":"$correlation_id"}';
    }

    # Login's refill is one token per minute, so a 1s Retry-After would lie.
    location @ratelimited_login {
        default_type application/json;
        include /etc/nginx/snippets/response-headers.conf;
        add_header Retry-After 60 always;
        return 429 '{"error":"TOO_MANY_REQUESTS","message":"too many login attempts, retry later","traceId":"$correlation_id"}';
    }

    location @upstream_unavailable {
        default_type application/json;
        return 503 '{"error":"SERVICE_UNAVAILABLE","message":"the upstream service is not reachable","traceId":"$correlation_id"}';
    }

    # Public auth routes (ADR-014): no Authorization required at the gateway;
    # synkro-auth-api validates credentials / the refresh token itself.
    # `location =` wins over any regex location, so the regex below keeps
    # protecting register, logout, users and service-tokens.
    location = /api/v1/auth/login {
        include /etc/nginx/snippets/gateway-base.conf;
        limit_req zone=login burst=4 nodelay;
        error_page 429 = @ratelimited_login;
        set $upstream http://synkro-auth-api:8080;
        proxy_pass $upstream;
    }

    location = /api/v1/auth/refresh {
        include /etc/nginx/snippets/gateway-public.conf;
        set $upstream http://synkro-auth-api:8080;
        proxy_pass $upstream;
    }

    # Regex locations so both /api/v1/products and /api/v1/products/...
    # match without NGINX's automatic trailing-slash 301, while
    # /api/v1/productsfoo does not.
    location ~ ^/api/v1/auth(/|$) {
        include /etc/nginx/snippets/gateway-protected.conf;
        set $upstream http://synkro-auth-api:8080;
        proxy_pass $upstream;
    }

    location ~ ^/api/v1/customers(/|$) {
        include /etc/nginx/snippets/gateway-protected.conf;
        set $upstream http://synkro-customers-api:8080;
        proxy_pass $upstream;
    }

    location ~ ^/api/v1/(products|stock-alerts)(/|$) {
        include /etc/nginx/snippets/gateway-protected.conf;
        set $upstream http://synkro-products-api:8080;
        proxy_pass $upstream;
    }

    location ~ ^/api/v1/sales(/|$) {
        include /etc/nginx/snippets/gateway-protected.conf;
        set $upstream http://synkro-sales-api:8080;
        proxy_pass $upstream;
    }

    location ~ ^/api/v1/sagas(/|$) {
        include /etc/nginx/snippets/gateway-protected.conf;
        set $upstream http://synkro-workflow:8080;
        proxy_pass $upstream;
    }
}
