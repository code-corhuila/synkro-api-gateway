#!/bin/sh
# Sourced before the image renders templates. Invalid deployment input fails closed.
: "${CUSTOMERS_LIST_RATE_PER_MINUTE:=30}"
: "${CUSTOMERS_LIST_BURST:=4}"
: "${CUSTOMERS_LIST_MAX_CONCURRENT:=2}"
: "${CUSTOMERS_LIST_CONNECT_TIMEOUT_SECONDS:=1}"
: "${CUSTOMERS_LIST_SEND_TIMEOUT_SECONDS:=2}"
: "${CUSTOMERS_LIST_READ_TIMEOUT_SECONDS:=2}"
budget_integer() {
    case "$2" in ''|*[!0-9]*) echo "Invalid customer list setting: $1" >&2; exit 1;; esac
    case "$2" in 0*) echo "Customer list settings must be positive canonical integers: $1" >&2; exit 1;; esac
    if [ "${#2}" -gt 4 ] || [ "$2" -lt "$3" ] || [ "$2" -gt "$4" ]; then
        echo "Out-of-range customer list setting: $1" >&2; exit 1
    fi
}
budget_integer rate "$CUSTOMERS_LIST_RATE_PER_MINUTE" 1 600
budget_integer burst "$CUSTOMERS_LIST_BURST" 1 20
budget_integer concurrency "$CUSTOMERS_LIST_MAX_CONCURRENT" 1 4
budget_integer connect-timeout "$CUSTOMERS_LIST_CONNECT_TIMEOUT_SECONDS" 1 3
budget_integer send-timeout "$CUSTOMERS_LIST_SEND_TIMEOUT_SECONDS" 1 5
budget_integer read-timeout "$CUSTOMERS_LIST_READ_TIMEOUT_SECONDS" 1 5
CUSTOMERS_LIST_RETRY_AFTER=$(((60 + CUSTOMERS_LIST_RATE_PER_MINUTE - 1) / CUSTOMERS_LIST_RATE_PER_MINUTE))
# The aggregate listing budget refills every five seconds.
if [ "$CUSTOMERS_LIST_RETRY_AFTER" -lt 5 ]; then CUSTOMERS_LIST_RETRY_AFTER=5; fi
export CUSTOMERS_LIST_RATE_PER_MINUTE CUSTOMERS_LIST_BURST CUSTOMERS_LIST_MAX_CONCURRENT
export CUSTOMERS_LIST_CONNECT_TIMEOUT_SECONDS CUSTOMERS_LIST_SEND_TIMEOUT_SECONDS CUSTOMERS_LIST_READ_TIMEOUT_SECONDS CUSTOMERS_LIST_RETRY_AFTER
